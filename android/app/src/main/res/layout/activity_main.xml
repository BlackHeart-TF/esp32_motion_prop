<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/bone"
            android:textSize="32sp" />

        <Button
            android:id="@+id/firmware"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/firmware"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp"
        android:text="@string/hint"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/scare"
        style="@style/Widget.Coffin.Button"
        android:backgroundTint="@color/scare"
        android:text="@string/scare" />

    <Button
        android:id="@+id/open"
        style="@style/Widget.Coffin.Button"
        android:backgroundTint="@color/open"
        android:text="@string/open"
        android:textColor="@color/bg" />

    <Button
        android:id="@+id/reset"
        style="@style/Widget.Coffin.Button"
        android:backgroundTint="@color/reset"
        android:text="@string/reset" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="@string/ready"
        android:textColor="@color/bone"
        android:textSize="16sp" />
</LinearLayout>
