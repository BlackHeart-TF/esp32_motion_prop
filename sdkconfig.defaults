CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Bench chip is 8 MB. The prop module is 16 MB. Set both of these together:
#   8 MB:  CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
#          CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"
#   16 MB: CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
#          CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A mismatch aborts at startup, before the status LED or USB mass storage.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# USB Serial/JTAG shares GPIO 19/20 with the USB device controller.
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set
CONFIG_TINYUSB_MSC_ENABLED=y
# 512 makes desktop copies time out. 8192 is the largest the S3 USB driver allows.
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_SAFE=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
